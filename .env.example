# ===========================================================================
# Cloud Vault — example environment (§59)
# Copy to .env and adjust. NEVER commit the real .env — it is git-ignored.
#   cp .env.example .env
# ===========================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=cloudvault
POSTGRES_USER=cloudvault
# Required: strong password for the database role (never commit the real one)
POSTGRES_PASSWORD=change-me-db-password

# --- Bootstrap administrator ------------------------------------------------
# Created on first start ONLY from these environment values — never hardcoded.
ADMIN_USERNAME=admin
# Required: at least 10 characters, mixed classes recommended
ADMIN_PASSWORD=change-me-admin-password

# --- Application ------------------------------------------------------------
APP_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# --- Storage (§4, §5, §50) --------------------------------------------------
# Host directory that becomes STORAGE_ROOT inside the container. Use an
# explicitly mounted drive path in production, e.g. /mnt/cloudvault-storage.
STORAGE_HOST_PATH=./data/storage

# --- Limits -----------------------------------------------------------------
TRASH_RETENTION_DAYS=30
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=10
MAX_FILE_SIZE=10GB

# --- JVM --------------------------------------------------------------------
JAVA_OPTS=-Xmx512m

# --- Optional: SMTP for password-reset mail ---------------------------------
# When unset, the reset endpoint reports 503 and administrators can issue
# a reset from the admin console (never a fake "email sent").
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@cloudvault.local
